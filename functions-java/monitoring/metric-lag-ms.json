{
  "name": "migration_lag_ms",
  "description": "GCF live synchronization lag in milliseconds (Linear Gauge)",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"firestore-migration-sink\" AND jsonPayload.message:\"MIGRATION_METRIC: lag_ms\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  },
  "valueExtractor": "REGEXP_EXTRACT(jsonPayload.message, \"lag=(\\\\d+)\")",
  "bucketOptions": {
    "linearBuckets": {
      "numFiniteBuckets": 1,
      "width": 1000000000,
      "offset": 0
    }
  }
}
